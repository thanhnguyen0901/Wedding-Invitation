{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/nha-co-dau", "destination": "/nha-co-dau/index.html" },
    { "source": "/nha-chu-re", "destination": "/nha-chu-re/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
