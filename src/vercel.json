{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    { "handle": "filesystem" },
    { "src": "/nha-co-dau$", "dest": "/nha-co-dau/index.html" },
    { "src": "/nha-chu-re$", "dest": "/nha-chu-re/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
